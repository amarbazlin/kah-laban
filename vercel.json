{
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    }
  ]
}